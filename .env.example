# Copy this file to .env.local and fill in real values. Never commit .env.local.

# The site's public URL, used for SEO tags, the sitemap, and OG images.
NEXT_PUBLIC_SITE_URL=https://juliettebruner.com

# Optional — once you connect a real email provider (Resend, Postmark,
# SendGrid) to app/api/contact/route.ts, its API key goes here.
# CONTACT_EMAIL_API_KEY=
